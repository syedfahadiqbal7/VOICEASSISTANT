# Optional cloud failover. Leave disabled to use local Ollama only.
VOICEASSISTANT_FAILOVER=0
VOICEASSISTANT_CLOUD_BASE_URL=https://api.openai.com/v1
VOICEASSISTANT_CLOUD_MODEL=gpt-4o-mini
# Set this in your OS/user environment; never commit a real key.
VOICEASSISTANT_CLOUD_API_KEY=

# Mobile API defaults to loopback. For trusted LAN only, set host to 0.0.0.0
# and configure a random token with at least 32 characters.
VOICEASSISTANT_MOBILE_HOST=127.0.0.1
VOICEASSISTANT_MOBILE_TOKEN=

# Optional QR pairing. Use the public HTTPS origin the phone can reach.
# For cross-network use, expose this only through a trusted VPN or TLS reverse proxy.
# VOICEASSISTANT_MOBILE_PUBLIC_URL=https://your-trusted-hostname
# For LAN / VPN access, explicitly bind the mobile API to the reachable interface.
# Keep device enrollment enabled and restrict access with Windows Firewall.
# VOICEASSISTANT_MOBILE_HOST=0.0.0.0
# Direct TLS mode requires both certificate and private-key files.
# VOICEASSISTANT_TLS_CERTFILE=C:/VoiceAssistant/certs/server.crt
# VOICEASSISTANT_TLS_KEYFILE=C:/VoiceAssistant/certs/server.key

# Only trust explicitly configured TLS reverse-proxy source addresses.
# VOICEASSISTANT_TRUSTED_PROXY_IPS=127.0.0.1,10.20.0.5
